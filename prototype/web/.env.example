# Configuración opcional del frontend (Vite).
# No contiene secretos. Copiar a .env.local solo si hace falta; no versionar ese archivo.

# Debe ser una ruta del mismo origen. Una URL externa se descarta con advertencia
# porque la cookie de sesión es del mismo origen.
VITE_API_BASE=/api/v1

# Nombres provisionales del mecanismo double-submit cookie para CSRF.
# Backend debe confirmarlos antes de la integración real.
VITE_CSRF_COOKIE=csrf_token
VITE_CSRF_HEADER=X-CSRF-Token
VITE_CSRF_META=csrf-token
